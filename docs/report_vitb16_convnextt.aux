\newlabel{sec:what}{{13}{13}}
\@writefile{toc}{\contentsline {paragraph}{1. The selection is blind to single-shift collapses.}{13}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{2. The tuning shifts are not representative of the failures.}{13}{}\protected@file@percent }
