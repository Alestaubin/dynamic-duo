\@writefile{toc}{\contentsline {paragraph}{Reproduce.}{7}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Test stream, seed 0: Vanilla DD (top), the ViT-B/16{} and the ResNet-50{} (below) under every condition, accuracy over windows of 5,120 images; the dashed grey line is the frozen duo / member, dashed lines the references (episodic, oracle). Without a reset (black) both members die (accuracy below 5\% for four windows of 5,120 images): the ResNet-50{} from 158,720 images, the ViT-B/16{} from 430,080. \texttt  {both\_fast\_vs\_slow} (blue) leaves the ResNet-50{} at 0\% until about 400k.}}{8}{}\protected@file@percent }
\newlabel{fig:overlay-test}{{1}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces As Figure\nobreakspace  {}1\hbox {} on the held-out stream (4 shifts $\times $ 4 rounds, rotation 0).}}{9}{}\protected@file@percent }
\newlabel{fig:overlay-held}{{2}{9}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \texttt  {gap\_fast\_vs\_slow}, test stream, seed 0: accuracy of the frozen duo, the fixed-TS duo, Vanilla DD and both members; the gate's weight on the ViT-B/16{}; the proxy scores it reads. A triangle marks each reset (dark: ViT-B/16{}, light: ResNet-50{}), a line the same reset in the weight panel. The ResNet-50{} is reset first and the ViT-B/16{} 20--69k images later, six times in a row in the first 400k images.}}{10}{}\protected@file@percent }
\newlabel{fig:gap}{{3}{10}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \texttt  {own\_fast\_vs\_slow}, test stream, seed 0, as Figure\nobreakspace  {}3\hbox {}. It resets far less often: seven resets in all, the ResNet-50{} at 133k, 278k, 551k and 701k images and the ViT-B/16{} at 345k, 415k and 605k; the shaded band is the ResNet-50{}'s collapse episode, reset at 278k. Between 278k and 551k the ResNet-50{} is not reset.}}{11}{}\protected@file@percent }
\newlabel{fig:own}{{4}{11}}
