\@writefile{toc}{\contentsline {section}{\numberline {10}Final test}{13}{}\protected@file@percent }
\newlabel{sec:final}{{10}{13}}
\@writefile{lot}{\contentsline {table}{\numberline {19}{\ignorespaces Stage 4, held-out validation rotation 1: \texttt  {own\_fast\_vs\_slow} ($\delta =0.7$; ViT-B/16{} $5.6{\cdot }10^{-4}$, ResNet-50{} $8.84{\cdot }10^{-5}$) against a trigger that resets each member as often as the rule did, at random steps (five draws). Accuracy (\%) and the paired difference per visit (mean$\pm $SE over the 16 visits; visits won by the rule). The rule's advantage is almost all in the ViT-B/16{}.}}{14}{}\protected@file@percent }
\newlabel{tab:tune_control}{{19}{14}}
\@writefile{lot}{\contentsline {table}{\numberline {20}{\ignorespaces Final test: accuracy (\%, mean over the 15 corruptions) on the ImageNet-C test stream, every configuration as tuned on the held-out stream, the gate at $\beta =0.5$. Mean$\pm $SE over 5 orderings of the corruptions (standard order and CoTTA's random orders); resets per 1,000 proxy batches for the ViT / ResNet. Frozen and the episodic reset are order-independent (scripts/03b rows). Produced by \texttt  {scripts/42\_final\_test.py}.}}{14}{}\protected@file@percent }
\newlabel{tab:final_test}{{20}{14}}
\@writefile{toc}{\contentsline {paragraph}{Claim (a): the best rule beats the tuned no-reset duo --- it does, for all three rules.}{14}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Claim (b): the rule beats random resets at matched counts --- on average, and less than on held-out.}{14}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {21}{\ignorespaces Paired differences on the test stream: per corruption (its accuracy averaged over the orderings), mean, standard error over the 15 corruptions, bootstrap 95\% interval over corruptions (10,000 resamples) and the number of corruptions the first method wins. Corruptions are not independent, so the interval is a noise floor, not a guarantee.}}{15}{}\protected@file@percent }
\newlabel{tab:final_paired}{{21}{15}}
\@writefile{toc}{\contentsline {paragraph}{Claim (c): against the boundary reset and the schedules --- reported as it came out.}{15}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Where the gain comes from.}{15}{}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What the test supports.}{15}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {22}{\ignorespaces Final test, per corruption (severity 5; accuracy of Vanilla DD, $\beta =0.5$, \%): each corruption's accuracy averaged over the orderings of the stream (the episodic reset and the frozen duo: scripts/03b rows). Bold: the best method on that corruption.}}{16}{}\protected@file@percent }
\newlabel{tab:final_per_shift}{{22}{16}}
